// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "soft_wrap": "editor_width",
  "agent_servers": {
    "opencode": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "mode": "acceptEdits"
      },
      "type": "registry"
    }
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  // Keep Zed-created git worktrees where we standardised them (../sted-worktrees
  // relative to the repo root). Testing whether Zed will also *list* CLI-created
  // worktrees that live here in the "Open Worktrees" picker (EDM-317).
  "git": {
    "worktree_directory": "../sted-worktrees",
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
}
