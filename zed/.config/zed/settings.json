{
  "ssh_connections": [
    {
      "host": "lima-sandbox",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/edmacovaz.guest/work"
          ]
        }
      ]
    }
  ],
  "proxy": "",
  "soft_wrap": "editor_width",
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "acceptEdits",
        "model": "claude-opus-4-8[1m]"
      },
      "type": "registry"
    },
    "opencode": {
      "type": "registry",
      "default_config_options": {
        "mode": "planner",
        "model": "opencode-go/glm-5.3"
      }
    }
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
}
