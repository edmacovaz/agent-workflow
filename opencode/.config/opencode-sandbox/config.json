{
  "filesystem": {
    "denyRead": [
      "~/.ssh",
      "~/.gnupg",
      "~/.aws/credentials",
      "~/.azure",
      "~/.config/gcloud",
      "~/.config/gh",
      "~/.kube",
      "~/.docker/config.json",
      "~/.npmrc",
      "~/.netrc",
      "~/.env"
    ],
    "allowWrite": [".", "/tmp"]
  },
  "network": {
    "allowedDomains": [
      "registry.npmjs.org",
      "*.npmjs.org",
      "registry.yarnpkg.com",
      "pypi.org",
      "crates.io",
      "github.com",
      "*.github.com",
      "gitlab.com",
      "*.gitlab.com",
      "api.openai.com",
      "api.anthropic.com",
      "*.googleapis.com",
      "api.doppler.com",
      "api.vercel.com",
      "*.vercel.com",
      "api.trigger.dev",
      "*.trigger.dev",
      "*.neon.tech",
      "api.locationiq.com",
      "api.mapbox.com",
      "*.mapbox.com",
      "*.posthog.com",
      "*.langfuse.com",
      "*.clerk.com",
      "*.clerk.accounts.dev",
      "api.linear.app"
    ]
  }
}
